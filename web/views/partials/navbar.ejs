<header class="navbar">
  <div class="nav-left">
    <a href="<%= user ? '/my' : '/' %>">BritRust <span class="nav-full">Ticket System</span></a>
    <% if (typeof navExtraLeftHref === 'string' && navExtraLeftHref) { %>
      <a class="nav-extra" href="<%= navExtraLeftHref %>"><%= navExtraLeftLabel || 'Back' %></a>
    <% } %>
  </div>
  <% if (typeof transcriptFile === 'string' && transcriptFile) { %>
    <div class="nav-center">
      <strong><%= transcriptFile %></strong>
      <% if (ownerId || steamId || ticketId) { %>
        <div class="muted nav-meta">
          <% if (ticketId) { %>Ticket #<%= ticketId %><% } %>
          <% if (ownerId) { %> • Discord: <%= ownerId %><% } %>
          <% if (steamId) { %> • SteamID: <%= steamId %><% } %>
        </div>
      <% } %>
    </div>
  <% } %>
  <input type="checkbox" id="nav-open" class="nav-open-input" aria-hidden="true">
  <label for="nav-open" class="nav-toggle" aria-label="Open menu">
    <span></span>
    <span></span>
    <span></span>
  </label>
  <nav id="site-nav" class="nav-right">
    <% if (typeof navExtraLeftHref === 'string' && navExtraLeftHref) { %>
      <a class="btn nav-extra-menu" href="<%= navExtraLeftHref %>"><%= navExtraLeftLabel || 'Back' %></a>
    <% } %>
    <% if (user) { %>
      <span class="userpill">
        <span class="avatar" style="background-image:url('https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64')"></span>
        <strong><%= user.username %></strong>
      </span>
      <a class="btn" href="/my">My Tickets</a>
      <% if (roleFlags && roleFlags.isStaff) { %>
        <a class="btn" href="/staff">Staff View</a>
      <% } %>
      <% if (canSeeApplications) { %>
        <a class="btn" href="/applications">Applications</a>
      <% } %>
      <a class="btn" href="/logout">Logout</a>
    <% } else { %>
      <a class="discord-login" href="/login">
        <img alt="Discord" src="https://cdn.prod.website-files.com/6257adef93867e50d84d30e2/66e3d7f4ef6498ac018f2c55_Symbol.svg" height="24" />
        <span>Login with Discord</span>
      </a>
    <% } %>
  </nav>
</header>
